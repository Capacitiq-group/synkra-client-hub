# Build-time variables. Add these as Coolify build arguments/environment
# variables before the image is built. VITE_ values are embedded in the
# browser bundle and must never contain secrets.
VITE_POCKETBASE_URL=https://pb.synkra.co.za
VITE_API_URL=https://api.synkra.co.za
VITE_APP_URL=https://client.synkra.co.za
VITE_APP_NAME=Synkra
VITE_LOOM_VIDEO_ACTIVATING_TEMPLATE=
VITE_LOOM_VIDEO_BUILDING_WORKFLOW=
VITE_LOOM_VIDEO_ACTIVITY_LOGS=

# Runtime variables for the Node container. These are not secrets.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
