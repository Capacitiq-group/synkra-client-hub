# ---------------------------------------------------------------------------
# BUILD-TIME (Coolify: Build Arguments). Vite embeds these in the browser
# bundle at docker build time. Runtime-only env vars are ignored by Vite.
# Never put a secret in a VITE_ variable.
# ---------------------------------------------------------------------------
VITE_POCKETBASE_URL=https://pb.synkra.co.za
VITE_APP_URL=https://client.synkra.co.za
VITE_APP_NAME=Synkra
VITE_API_URL=https://api.synkra.co.za
VITE_LOOM_VIDEO_TEMPLATES=
VITE_LOOM_VIDEO_BUILDER=
VITE_LOOM_VIDEO_LOGS=

# ---------------------------------------------------------------------------
# RUNTIME (Coolify: Environment Variables). Read by the Node server only,
# never shipped to the browser. API_SECRET must match WEBHOOK_SECRET in
# synkra-core.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_URL=https://api.synkra.co.za
API_SECRET=same_value_as_WEBHOOK_SECRET_in_synkra_core

# ---------------------------------------------------------------------------
# DEPLOY SCRIPTS (npm run seed / npm run smoke). Runtime only, never bundled.
# ---------------------------------------------------------------------------
POCKETBASE_URL=http://167.86.106.152:8093
PB_ADMIN_EMAIL=your_pocketbase_superuser_email
PB_ADMIN_PASSWORD=your_pocketbase_superuser_password
SEED_OWNER_EMAIL=rmolapisi@capacitiqgroup.co.za
SEED_OWNER_PASSWORD=choose_a_strong_password
SEED_STRICT=false
APP_URL=https://client.synkra.co.za
SMOKE_NOTIFY_EMAIL=rmolapisi@capacitiqgroup.co.za


# ---------------------------------------------------------------------------
# BILLING + MAGIC LINK (runtime only, never bundled).
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxx
RESEND_API_KEY=re_xxx
RESEND_FROM=Synkra <noreply@synkra.co.za>
